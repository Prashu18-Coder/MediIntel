# ── MediCore Backend — Environment Variables (MongoDB Atlas) ─────────────────
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your Atlas connection string and JWT secret
# 3. Never commit .env to Git

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: Atlas Dashboard → Cluster → Connect → Drivers → Node.js
# Replace <username>, <password>, <cluster-url>, and <dbname>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# Example (replace with your real values):
# MONGO_URI=mongodb+srv://john:mypassword123@cluster0.abc12.mongodb.net/medicore?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=medicore_change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Twilio SMS (optional — for emergency alerts) ──────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+1234567890

# ── n8n Webhook (optional) ────────────────────────────────────────────────────
N8N_EMERGENCY_WEBHOOK=http://localhost:5678/webhook/emergency-alert

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Groq AI (Llama 3.3 70B) ──────────────────────────────────────────────────
# Get your free key from: https://console.groq.com
# Powers: Report Analysis, Medicine Scan, Mental Health Chat,
#         Symptom Checker, Diabetes Interpretation
GROQ_API_KEY=your_groq_api_key_here
